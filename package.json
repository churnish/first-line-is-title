{
  "name": "first-line-is-title",
  "version": "3.11.0",
  "description": "Automatically set the first line as note title.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npx tsc -v -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "css": "true",
    "knip": "npx knip --no-config-hints",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git tag -d v$(node -p \"require('./package.json').version\") 2>/dev/null || true && git tag $(node -p \"require('./package.json').version\")"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.2",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^17.4.0",
    "jsdom": "^25.0.1",
    "obsidian": "^1.11.4",
    "prettier": "^3.8.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "monkey-around": "^3.0.0"
  }
}
