{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["main.ts"],
  "project": ["src/**/*.ts", "tests/**/*.ts"],
  "ignoreDependencies": [
    "@eslint/compat",
    "@typescript-eslint/eslint-plugin",
    "prettier"
  ],
  "ignoreBinaries": ["eslint", "knip", "vitest"],
  "exclude": ["exports"],
  "ignore": ["src/utils/timestamp-rate-limiter.ts"],
  "ignoreExportsUsedInFile": true
}
